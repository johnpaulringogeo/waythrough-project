{#- Reader-question page and hub template (bilingual EN/ES). Rendered by
    scripts/generate_questions.py from data/questions/<slug>.json. page_kind is
    "question" (one answer page) or "hub" (the topic-grouped list of all of them).
    Context: page_kind, lang, t, q (question pages), groups (hub), title, description,
    canonical_path, alt_en_url, alt_es_url, rel_prefix, home_href, resources_href,
    hub_href, ask_href, breadcrumb_json, article_json -#}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YQ0HKFH50D"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-YQ0HKFH50D');
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="{{ rel_prefix }}images/favicon.png">
    <link rel="icon" type="image/x-icon" href="{{ rel_prefix }}images/favicon.ico">
    <link rel="apple-touch-icon" href="{{ rel_prefix }}images/apple-touch-icon.png">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:type" content="{{ 'article' if page_kind == 'question' else 'website' }}">
    <meta property="og:url" content="https://waythroughproject.com{{ canonical_path }}">
    <meta property="og:site_name" content="Waythrough Project">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="canonical" href="https://waythroughproject.com{{ canonical_path }}">
    <link rel="alternate" hreflang="en" href="{{ alt_en_url }}">
    <link rel="alternate" hreflang="es" href="{{ alt_es_url }}">
    <link rel="alternate" hreflang="x-default" href="{{ alt_en_url }}">
    <meta property="og:image" content="https://waythroughproject.com/images/og-default.png">
    <meta name="twitter:image" content="https://waythroughproject.com/images/og-default.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet"></noscript>
    <script>(function(){try{var t=localStorage.getItem('theme');if(!t){t=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
    <link rel="stylesheet" href="{{ rel_prefix }}css/style.css?v=34">
    <script type="application/ld+json">
{{ breadcrumb_json }}
    </script>
    {%- if article_json %}
    <script type="application/ld+json">
{{ article_json }}
    </script>
    {%- endif %}
</head>
<body>
    <main id="main-content">
        {%- if page_kind == 'question' %}
        <nav class="breadcrumbs" aria-label="Breadcrumb"><div class="container"><a href="{{ home_href }}">{{ t.home }}</a><span class="sep">/</span><a href="{{ resources_href }}">{{ t.resources }}</a><span class="sep">/</span><a href="{{ hub_href }}">{{ t.hub_crumb }}</a><span class="sep">/</span><span class="current">{{ q.crumb }}</span></div></nav>
        <header class="page-header">
            <div class="container">
                <span class="section-label">{{ t.section_label }}</span>
                <h1>{{ q.h1 }}</h1>
                <p class="page-meta">{{ t.page_meta }}</p>
            </div>
        </header>
        <div class="container">
            <div class="post-content">
                <div class="callout">
                    <h2 style="font-size:1.1rem;margin-top:0;">{{ t.question_heading }}</h2>
                    <p><em>&ldquo;{{ q.question }}&rdquo;</em></p>
                    <p style="font-size:0.9rem;margin-bottom:0;">{{ t.privacy_note }}</p>
                </div>

                <div class="callout">
                    <h2 style="font-size:1.1rem;margin-top:0;">{{ t.short_answer }}</h2>
                    <p>{{ q.short_answer }}</p>
                </div>

{{ q.body_html }}

                <div class="callout">
                    <p>{{ t.not_legal_advice_html }}</p>
                </div>

                {%- if q.links %}
                <h2>{{ t.guides_heading }}</h2>
                <div class="related-list">
                    {%- for l in q.links %}
                    <a href="{{ l.href }}" class="related-item">
                        <h3>{{ l.label }}</h3>
                        {%- if l.note %}
                        <p>{{ l.note }}</p>
                        {%- endif %}
                    </a>
                    {%- endfor %}
                </div>
                {%- endif %}

                {%- if q.related %}
                <h2>{{ t.related_heading }}</h2>
                <ul>
                    {%- for r in q.related %}
                    <li><a href="{{ r.href }}">{{ r.h1 }}</a></li>
                    {%- endfor %}
                </ul>
                {%- endif %}

                {%- if q.sources %}
                <h2>{{ t.sources }}</h2>
                <ul>
                    {%- for s in q.sources %}
                    <li><a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.label }}</a></li>
                    {%- endfor %}
                </ul>
                {%- endif %}

                <p style="margin-top:2rem;">{{ t.ask_cta_html }}</p>
            </div>
        </div>
        {%- else %}
        <nav class="breadcrumbs" aria-label="Breadcrumb"><div class="container"><a href="{{ home_href }}">{{ t.home }}</a><span class="sep">/</span><a href="{{ resources_href }}">{{ t.resources }}</a><span class="sep">/</span><span class="current">{{ t.hub_crumb }}</span></div></nav>
        <header class="page-header">
            <div class="container">
                <span class="section-label">{{ t.hub_label }}</span>
                <h1>{{ t.hub_h1 }}</h1>
                <p class="page-meta">{{ t.hub_meta }}</p>
            </div>
        </header>
        <div class="container">
            <div class="post-content">
                <p>{{ t.hub_intro_html }}</p>
                <div class="callout">
                    <p>{{ t.hub_urgent_html }}</p>
                </div>
                {%- for g in groups %}

                <h2>{{ g.label }}</h2>
                <div class="related-list">
                    {%- for item in g.entries %}
                    <a href="{{ item.href }}" class="related-item">
                        <h3>{{ item.h1 }}</h3>
                        <p>{{ item.short_answer }}</p>
                    </a>
                    {%- endfor %}
                </div>
                {%- endfor %}

                <p style="margin-top:2rem;">{{ t.ask_cta_html }}</p>
            </div>
        </div>
        {%- endif %}
    </main>

    <script src="{{ rel_prefix }}js/components.js?v=39" defer></script>
</body>
</html>
